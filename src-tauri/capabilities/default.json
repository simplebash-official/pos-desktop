{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core permissions for the splash and main windows, plus permission to run the bundled backend / document-server sidecars.",
  "windows": ["main", "splashscreen"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:event:default",
    "updater:default",
    "process:allow-restart",
    "devtools:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "binaries/simplebash-backend", "sidecar": true },
        { "name": "binaries/simplebash-document-server", "sidecar": true }
      ]
    }
  ]
}
