# docker-compose environment for jana2u-pos (backend + document-server + frontend)
# Copy this file to .env and fill in your secrets before starting the stack.

# --- backend: database engine ('sqlite' or 'mongodb') ---
DATABASE_TYPE=sqlite
DATABASE_URL=sqlite:///app/data/pos.db?mode=rwc

# --- backend: MongoDB (Atlas cluster or local connection string, used when DATABASE_TYPE=mongodb) ---
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=jana2u_pos_dev

# --- backend: auth ---
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
JWT_EXPIRY_HOURS=12

# --- backend: business config ---
RETURN_WINDOW_DAYS=30
AUTO_SEED=true

# --- shared secret: backend's DOCUMENT_SERVER_API_KEY == document-server's INTERNAL_API_KEY ---
DOCUMENT_SERVER_API_KEY=replace_with_a_secure_random_64_character_hex_string

# --- frontend: baked into the Vite build at image-build time ---
VITE_API_BASE_URL=http://localhost:8080/api
VITE_APP_NAME=Jana2U POS

# --- frontend: host port published for the nginx container ---
FRONTEND_PORT=8081
