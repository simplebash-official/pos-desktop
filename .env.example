# ==============================================================================
# myrologic-pos: Full-Stack Docker Compose Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in production secrets before starting the stack:
#   cp .env.example .env
#
# Services orchestrated by Docker Compose:
#   - backend: Rust/Axum REST API (port 8080 internal)
#   - document-server: Typst PDF rendering service (port 8090 internal)
#   - frontend: React + Vite web client (Nginx container published to FRONTEND_PORT)
#   - seed: Standalone seeding profile (`docker compose --profile seed run --rm seed`)
# ==============================================================================

# ==============================================================================
# 1. DATABASE CONFIGURATION (DUAL-ENGINE)
# ==============================================================================
# Select persistence engine: 'sqlite' (default, local file) or 'mongodb' (remote/cluster).
DATABASE_TYPE=sqlite

# SQLite configuration (used when DATABASE_TYPE=sqlite).
# In Docker, persistence volume is mounted to /app/data.
DATABASE_URL=sqlite:///app/data/pos.db?mode=rwc

# MongoDB configuration (required only when DATABASE_TYPE=mongodb).
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=myrologic_pos_dev

# ==============================================================================
# 2. BACKEND AUTHENTICATION & SECURITY
# ==============================================================================
# Random 64-character hex secret used for signing and verifying JWT access tokens.
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string

# Access token expiration time in hours (single-session lifetime).
JWT_EXPIRY_HOURS=12

# ==============================================================================
# 3. INTER-SERVICE INTEGRATION (BACKEND <-> DOCUMENT SERVER)
# ==============================================================================
# Shared secret for internal communication between backend and document-server.
# Must match DOCUMENT_SERVER_API_KEY (in backend) and INTERNAL_API_KEY (in document-server).
DOCUMENT_SERVER_API_KEY=replace_with_a_secure_random_64_character_hex_string

# ==============================================================================
# 4. BUSINESS POLICY & SEEDING AUTOMATION
# ==============================================================================
# Return window in days: maximum duration after invoice creation to issue a credit note
# without requiring manager override authorization. Optional, defaults to 30.
RETURN_WINDOW_DAYS=30

# Automatically seed the database on backend startup if enabled ('true' or 'false').
# Runs all seeders idempotently in dependency order (admin, providers, suppliers, customers, inventory, api_key).
# Default admin account created: admin@pos.com / admin@1234
AUTO_SEED=true

# ==============================================================================
# 5. FRONTEND CLIENT CONFIGURATION
# ==============================================================================
# Base URL for backend API calls from browser client (baked in during build).
VITE_API_BASE_URL=http://localhost:8080/api

# Application branding title displayed across the UI and document headers.
VITE_APP_NAME=MyroLogic POS

# Host port mapped to the Nginx frontend web server container.
FRONTEND_PORT=8081
