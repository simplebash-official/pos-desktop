# ==============================================================================
# MyroLogic POS - Desktop Environment Configuration Example (.env.desktop)
# ==============================================================================
# Target: Local standalone desktop application (Tauri + SQLite)
# Copy this file to .env when running or testing desktop/sidecar builds:
#   npm run env:desktop
# ==============================================================================

# ==============================================================================
# 1. DATABASE CONFIGURATION (EMBEDDED SQLITE)
# ==============================================================================
DATABASE_TYPE=sqlite
DATABASE_URL=sqlite://data/pos.db?mode=rwc

# MongoDB settings remain empty in desktop mode
MONGODB_URI=
MONGODB_DB_NAME=

# ==============================================================================
# 2. NETWORKING & LOCAL SERVER
# ==============================================================================
PORT=8080
# Restrict to local loopback interface for safety
BIND_ADDR=127.0.0.1

# ==============================================================================
# 3. AUTHENTICATION & SECURITY (JWT)
# ==============================================================================
# Random 64-character hex secret for local session signing
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
JWT_EXPIRY_HOURS=12

# ==============================================================================
# 4. DOCUMENT SERVER INTEGRATION (LOCAL TYPST ENGINE)
# ==============================================================================
DOCUMENT_SERVER_URL=http://127.0.0.1:8090
DOCUMENT_SERVER_API_KEY=replace_with_a_secure_random_64_character_hex_string
GENERATED_DOCUMENTS_DIR=generated_documents

# ==============================================================================
# 5. BUSINESS RULES & SEEDING
# ==============================================================================
RETURN_WINDOW_DAYS=30
AUTO_SEED=true

# ==============================================================================
# 6. FRONTEND CLIENT CONFIGURATION
# ==============================================================================
# Desktop webview connects directly to local loopback sidecar backend
VITE_API_BASE_URL=http://127.0.0.1:8080/api
VITE_APP_NAME="MyroLogic POS Desktop"
FRONTEND_PORT=8081
