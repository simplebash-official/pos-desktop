# ==============================================================================
# SimpleBash POS - Web & Server Deployment Environment Configuration Example (.env.web)
# ==============================================================================
# Target: Cloud / VPS deployment (Docker Compose + MongoDB + Nginx Reverse Proxy)
# Copy this file to .env when running or testing web/server deployments:
#   npm run env:web
# ==============================================================================

# ==============================================================================
# 1. DATABASE CONFIGURATION (MONGODB)
# ==============================================================================
DATABASE_TYPE=mongodb

# MongoDB connection URI (e.g. MongoDB Atlas cluster):
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
# Database name in cluster:
MONGODB_DB_NAME=simplebash_pos_prod

# (If using the self-hosted Docker MongoDB profile in docker-compose, use:
#  MONGODB_URI=mongodb://mongo:27017
#  MONGODB_DB_NAME=simplebash_pos_prod)

# SQLite URL is not used when DATABASE_TYPE=mongodb
DATABASE_URL=

# ==============================================================================
# 2. NETWORKING & LISTENER
# ==============================================================================
PORT=8080
# Listen on all interfaces inside Docker container
BIND_ADDR=0.0.0.0

# ==============================================================================
# 3. AUTHENTICATION & SECURITY (JWT)
# ==============================================================================
# Must be a secure random 64-character hex string in production (run: openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
JWT_EXPIRY_HOURS=12

# ==============================================================================
# 4. DOCUMENT SERVER INTEGRATION (INTERNAL MICROSERVICE)
# ==============================================================================
DOCUMENT_SERVER_URL=http://document-server:8090
# Must match INTERNAL_API_KEY in document-server (run: openssl rand -hex 32)
DOCUMENT_SERVER_API_KEY=replace_with_a_secure_random_64_character_hex_string
GENERATED_DOCUMENTS_DIR=/app/generated_documents

# ==============================================================================
# 5. BUSINESS RULES & SEEDING AUTOMATION
# ==============================================================================
RETURN_WINDOW_DAYS=30
# AUTO_SEED needs SEED_ADMIN_PASSWORD (below) on a publicly reachable instance.
AUTO_SEED=true

# Optional: Bootstrap initial admin account credentials:
SEED_ADMIN_EMAIL=admin@pos.com
SEED_ADMIN_PASSWORD=replace_with_your_own_admin_password
SEED_ADMIN_NAME="System Administrator"

# ==============================================================================
# 6. FRONTEND CLIENT CONFIGURATION
# ==============================================================================
# Web frontend: relative '/api' for Nginx reverse proxy on the same domain,
# or absolute URL if frontend and backend are hosted on separate domains:
VITE_API_BASE_URL=/api
VITE_APP_NAME="SimpleBash POS"
FRONTEND_PORT=8081
