{
  "name": "jana2u-pos-desktop",
  "version": "0.7.0",
  "private": true,
  "description": "Tauri desktop bundle of the Jana2U POS frontend + backend + document-server",
  "scripts": {
    "tauri": "tauri",
    "sidecars": "bash scripts/build-sidecars.sh",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:desktop": "npm run sidecars && npm run build",
    "test:stress": "bash scripts/stress-test-desktop.sh",
    "env:desktop": "cp .env.desktop.example .env",
    "env:web": "cp .env.web.example .env",
    "web:build": "docker compose --env-file .env.web build",
    "web:up": "docker compose --env-file .env.web up -d",
    "web:down": "docker compose --env-file .env.web down",
    "web:logs": "docker compose --env-file .env.web logs -f"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
