{
  "name": "simplebash-pos-desktop",
  "version": "0.7.0",
  "private": true,
  "description": "Tauri desktop bundle of the SimpleBash POS frontend + backend + document-server",
  "scripts": {
    "setup:links": "bash scripts/setup-links.sh",
    "postinstall": "npm run setup:links",
    "tauri": "tauri",
    "sidecars": "bash scripts/build-sidecars.sh",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:desktop": "npm run sidecars && npm run build",
    "test:stress": "bash scripts/stress-test-desktop.sh",
    "env:desktop": "cp .env.desktop.example .env",
    "bench:logging": "bash scripts/bench-logging.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
